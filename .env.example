# ---------------------------------------------------------------------------
# KAVACHA example environment file
# Copy to .env (project root) or backend/.env and fill in real values.
# Never commit a filled-in .env. Credentials are read from the environment only.
# ---------------------------------------------------------------------------

# Flask
FLASK_ENV=development
HOST=127.0.0.1
PORT=5000

# Secrets — REQUIRED before any non-demo deployment
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-another-long-random-string
JWT_EXPIRES_MINUTES=720

# Database
# SQLite (default): sqlite:///C:/absolute/path/to/KAVACHA/backend/instance/kavacha.db
# PostgreSQL:        postgresql+psycopg://user:password@localhost:5432/kavacha
DATABASE_URL=

# Storage (absolute or project-relative path; files are never served publicly)
STORAGE_ROOT=

# Upload limits
MAX_UPLOAD_MB=25

# CORS (comma-separated origins allowed to call the API)
CORS_ORIGINS=http://localhost:5173,http://kavacha.localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Configurable demonstration risk bands (NOT calibrated fraud probabilities)
RISK_MEDIUM_THRESHOLD=30
RISK_HIGH_THRESHOLD=60
RISK_CRITICAL_THRESHOLD=80

# Rate limits (requests per window per client)
AUTH_RATE_LIMIT=12
AUTH_RATE_WINDOW=60
API_RATE_LIMIT=600
API_RATE_WINDOW=60

# OCR
OCR_LANGUAGES=eng,kan
OCR_MAX_WORDS=4000
ANALYSIS_MAX_PAGES=3

# Reports
# Public report link base. kavacha.localhost resolves to your own machine in modern
# browsers and needs no hosts-file edit. Use your real domain after deployment.
QR_BASE_URL=http://kavacha.localhost:5173/verify
REPORT_EXPIRY_DAYS=90

# Optional authorised external verification integrations.
# When these are empty KAVACHA explicitly reports that external verification
# was NOT performed. Never fabricate success.
EXTERNAL_GST_API_URL=
EXTERNAL_GST_API_KEY=
EXTERNAL_BANK_API_URL=
EXTERNAL_BANK_API_KEY=

# Retention
DEFAULT_RETENTION_DAYS=30

# Frontend (Vite)
# VITE_API_BASE_URL=/api
# VITE_API_PROXY=http://127.0.0.1:5000
