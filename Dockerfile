# syntax=docker/dockerfile:1.7

# ---------- frontend build ----------
FROM node:20-alpine AS frontend
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

# ---------- application ----------
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FLASK_ENV=production \
    FLASK_APP=run.py \
    MALLOC_ARENA_MAX=2

# Tesseract powers OCR for scanned pages; DejaVu fonts are used by the demo
# document generator; OpenCV needs libgomp/libglib.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      tesseract-ocr tesseract-ocr-eng tesseract-ocr-kan \
      fonts-dejavu-core libglib2.0-0 libgomp1 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app/backend
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./
COPY --from=frontend /build/frontend/dist /app/frontend/dist

# Seed the demo database and synthetic documents into the image so the first
# request is fast. Everything is generated by the real analysis pipeline.
RUN mkdir -p /app/storage /app/backend/instance \
 && python -m flask init-db \
 && python -m flask seed-demo --with-documents

COPY backend/docker-entrypoint.sh /usr/local/bin/kavacha-entrypoint
RUN chmod +x /usr/local/bin/kavacha-entrypoint

EXPOSE 10000
ENTRYPOINT ["/usr/local/bin/kavacha-entrypoint"]
